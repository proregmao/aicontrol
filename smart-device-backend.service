[Unit]
Description=Smart Device Management Backend Service
Documentation=https://github.com/your-org/smart-device-management
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service
Requires=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/data/smart-device-management/backend
ExecStart=/data/smart-device-management/backend/smart-device-management
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# 环境变量
Environment=DB_HOST=localhost
Environment=DB_PORT=5432
Environment=DB_USER=postgres
Environment=DB_PASSWORD=abcd1234
Environment=DB_NAME=smart_device_management
Environment=APP_PORT=2999
Environment=GIN_MODE=release
Environment=LOG_LEVEL=info

# 重启策略
Restart=always
RestartSec=10
StartLimitInterval=60
StartLimitBurst=3

# 安全设置
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/data/smart-device-management/backend
ReadWritePaths=/var/log

# 资源限制
LimitNOFILE=65536
LimitNPROC=4096

# 日志设置
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smart-device-backend

[Install]
WantedBy=multi-user.target
