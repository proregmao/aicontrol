# 智能设备管理系统生产环境配置模板
# 复制此文件为 .env.production 并填入实际值

# ===========================================
# 应用基础配置
# ===========================================
APP_NAME=智能设备管理系统
APP_VERSION=1.0.0
APP_ENV=production

# ===========================================
# 端口配置
# ===========================================
# 后端API端口
BACKEND_PORT=8080
BACKEND_HOST=0.0.0.0

# 前端服务端口
FRONTEND_PORT=80
FRONTEND_HOST=0.0.0.0

# ===========================================
# API配置
# ===========================================
# API基础URL (前端使用)
API_BASE_URL=https://your-domain.com/api/v1

# WebSocket URL (前端使用)
WS_URL=wss://your-domain.com/ws

# ===========================================
# 数据库配置 (生产环境)
# ===========================================
DB_TYPE=postgres
DB_HOST=your_production_db_host
DB_PORT=5432
DB_USER=your_production_db_user
DB_PASSWORD=your_secure_production_db_password
DB_NAME=smart_device_management_prod
DB_SSLMODE=require
DB_TIMEZONE=Asia/Shanghai

# ===========================================
# Redis配置 (生产环境)
# ===========================================
REDIS_HOST=your_production_redis_host
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_production_redis_password
REDIS_DB=0

# ===========================================
# JWT认证配置 (生产环境)
# ===========================================
# 请生成至少32位的强随机密钥
JWT_SECRET=your_super_secure_production_jwt_secret_at_least_32_characters
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=168h

# ===========================================
# 日志配置
# ===========================================
LOG_LEVEL=warn
LOG_FORMAT=json
LOG_OUTPUT=file

# ===========================================
# WebSocket配置
# ===========================================
WS_READ_BUFFER_SIZE=1024
WS_WRITE_BUFFER_SIZE=1024
WS_HEARTBEAT_INTERVAL=30s

# ===========================================
# 外部服务配置
# ===========================================
# Modbus配置
MODBUS_TIMEOUT=30s
MODBUS_RETRY_COUNT=3
MODBUS_RETRY_INTERVAL=5s

# 是否启用真实MODBUS数据读取
ENABLE_REAL_MODBUS=true

# SSH配置
SSH_TIMEOUT=30s
SSH_RETRY_COUNT=3
SSH_KEY_PATH=/etc/ssh/keys

# ===========================================
# 通知服务配置 (生产环境)
# ===========================================
# 钉钉通知
DINGTALK_WEBHOOK_URL=your_production_dingtalk_webhook_url
DINGTALK_SECRET=your_production_dingtalk_secret

# 邮件配置
SMTP_HOST=your_production_smtp_host
SMTP_PORT=587
SMTP_USERNAME=your_production_smtp_username
SMTP_PASSWORD=your_production_smtp_password
SMTP_FROM=noreply@your-domain.com

# ===========================================
# 安全配置 (生产环境)
# ===========================================
BCRYPT_COST=14
RATE_LIMIT_REQUESTS=50
RATE_LIMIT_WINDOW=1m

# ===========================================
# 监控配置 (生产环境)
# ===========================================
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30s

# ===========================================
# 前端配置
# ===========================================
# 应用标题
APP_TITLE=智能设备管理系统

# 生产环境禁用Mock数据和开发工具
USE_MOCK=false
DEV_TOOLS=false

# ===========================================
# SSL/TLS配置 (生产环境)
# ===========================================
# SSL证书路径
SSL_CERT_PATH=/etc/ssl/certs/your-domain.crt
SSL_KEY_PATH=/etc/ssl/private/your-domain.key

# ===========================================
# 备份配置 (生产环境)
# ===========================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/data/backups

# ===========================================
# 性能配置 (生产环境)
# ===========================================
MAX_CONNECTIONS=100
CONNECTION_TIMEOUT=30s
QUERY_TIMEOUT=10s
CACHE_TTL=300s
